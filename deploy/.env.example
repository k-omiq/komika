# Copy to deploy/.env and edit for your host. All values have sane defaults.

# The host BROWSERS use to reach the stack. For local use keep "localhost".
# For a real deploy set your domain or public IP, e.g. komika.example.com or 203.0.113.4.
PUBLIC_HOST=localhost

# Published ports (host side).
READER_PORT=8081
SERVER_PORT=8080
SUWAYOMI_PORT=4567

# Admin account for the Komika "manga DB" console (created by bootstrap.sh).
KOMIKA_ADMIN_USERS=admin
# Quote the password — deploy.sh shell-sources this file, so spaces or shell
# metacharacters in an unquoted value would break sourcing.
KOMIKA_ADMIN_PASSWORD="change-this-admin-pw"
KOMIKA_ADMIN_EMAIL=admin@example.com

# How often (seconds) the adaptive scanner re-evaluates the library for updates.
SCAN_TICK_SECONDS=300

# Comma-separated MangaDex series titles to auto-add to the library on bootstrap,
# so the catalog is populated and the scanner has things to keep updated.
# Leave empty to start with an empty library (users/admin can add series later).
# Quoted: the titles contain spaces and deploy.sh shell-sources this file.
SEED_SERIES="Chainsaw Man,Solo Leveling,One Piece,Jujutsu Kaisen,The Eminence in Shadow"

TZ=UTC

# --- Continuous backup (Litestream → S3/B2) ---------------------------------
# Leave BLANK to run without backup. To enable: create a bucket (Backblaze B2
# recommended — reuse the image-cache account) and an app key, then fill these in.
# On a fresh host the server restores the latest snapshot automatically before
# starting; while running it streams the WAL (point-in-time restore, ~seconds RPO).
# LITESTREAM_BUCKET=komika-backup
# LITESTREAM_ENDPOINT=s3.us-west-002.backblazeb2.com   # B2 S3 endpoint (region-specific)
# LITESTREAM_REGION=us-west-002
# LITESTREAM_ACCESS_KEY_ID=your-b2-key-id
# LITESTREAM_SECRET_ACCESS_KEY=your-b2-app-key
